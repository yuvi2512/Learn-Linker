# Copy to .env.local and fill in. Never commit the filled-in file.
#
# If a hosted value is missing, the app falls back automatically:
#   DATABASE_URL  → local Postgres at localhost:5432/learnlinker
#   NEXTAUTH_URL  → Vercel deployment URL, else http://localhost:3000

# --- Database (Neon on Vercel, local Postgres on your machine) ---
# Neon dashboard → Connection string. Prefer the *pooled* URI for the app
# (host contains -pooler) and append ?sslmode=require if it is not already there.
DATABASE_URL=postgres://user:password@localhost:5432/learnlinker

# Optional. Direct (unpooled) Neon URI used only by `npm run db:migrate`.
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Optional. Used only when DATABASE_URL is unset (local fallback override).
# DATABASE_URL_LOCAL=postgres://user:password@localhost:5432/learnlinker

# --- Auth ---
# NextAuth session signing secret. Required for login to work across API
# routes. Use the SAME value on every machine (and on Vercel). Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# After changing this, sign out and sign in again.
NEXTAUTH_SECRET=

# Public URL of this app. On Vercel set this to https://your-app.vercel.app
# If unset: uses VERCEL_URL when hosted, otherwise http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Bootstrap only: the first person who registers at /register/teacher with this
# code becomes the institute admin. After that, the admin creates and sends
# teacher invites from the Invites page — you can leave this set as a backup
# or clear it so only issued invites work.
TEACHER_INVITE_CODE=

# Optional: enables the AI study-notes generator.
COHERE_API_KEY=

# Optional: CA certificate for managed Postgres in production.
VERCEL_POSTGRES_CA_CERT=
