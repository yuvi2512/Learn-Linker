# Copy to .env.local and fill in. Never commit the filled-in file.

# Postgres connection string. Required.
DATABASE_URL=postgres://user:password@localhost:5432/learnlinker

# NextAuth session signing secret. Required.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Bootstrap only: the first person who registers at /register/teacher with this
# code becomes the institute admin. After that, the admin creates and sends
# teacher invites from the Invites page — you can leave this set as a backup
# or clear it so only issued invites work.
TEACHER_INVITE_CODE=

# Optional: restrict timetable publishing to named teachers (comma-separated
# emails). Leave empty to let any teacher publish.
NEXT_PUBLIC_TIMETABLE_ADMINS=

# Optional: enables the AI study-notes generator.
COHERE_API_KEY=

# Optional: CA certificate for managed Postgres in production.
VERCEL_POSTGRES_CA_CERT=
